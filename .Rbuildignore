^\.github$
^website$
^output$
^docs$
^pkgdown$
^_pkgdown\.yml$
^codecov\.yml$
^.*\.Rproj$
^\.Rproj\.user$

# Large data directories (RepoRT data)
^RepoRT_data$

# Runner setup files
^RUNNER_SETUP\.md$
^github_runner\.yml$
^\.github_runner\.env$

# Quarto articles for pkgdown (not R vignettes) and their rendered output
^vignettes/.*_files$
^vignettes/\.quarto$
^vignettes/.*\.qmd$
^vignettes/\.gitignore$
